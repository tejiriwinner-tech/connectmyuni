{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    { "src": "/frontend/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/storage/uploads/(.*)", "dest": "/storage/uploads/$1" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/api/index.php" },
    { "src": "/heartbeat", "dest": "/api/index.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "crons": [
    {
      "path": "/heartbeat",
      "schedule": "0 0 * * *"
    }
  ]
}
