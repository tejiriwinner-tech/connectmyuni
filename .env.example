# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_BASE_URL=/

# Supabase PostgreSQL Database Configuration
# REPLACE with real values from: Supabase Dashboard -> Settings -> Database -> Connection string
# Do not commit real credentials.
SUPABASE_DB_HOST=db.<your-project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=your_database_password_here
SUPABASE_DB_SSLMODE=require

# Session Configuration
SESSION_NAME=connectmyuni_session
SESSION_LIFETIME=1440

# AI Content Generator Configuration
# These values are read at runtime by AiContentService via the Config\env() helper.
# AI content generation is gracefully disabled if any of these are missing.
# AI provider selector:
#   gemini  -> Google Gemini via Google AI Studio (Recommended)
#   nvidia  -> NVIDIA NIM via AI_BASE_URL
#   openai  -> OpenAI
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.1-flash-lite

# Optional fallbacks:
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=your_nvidia_api_key_here
FAL_KEY=your_fal_ai_key_here
