# ==========================================================
# Connect MyUni — Environment Configuration (Template)
# ==========================================================
# Copy this file to .env and update with your local values.
# .env is git-ignored and should NEVER be committed.
# ==========================================================

# ── Application Environment ──────────────────────────────
APP_ENV=local
APP_DEBUG=true

# ── Database (MySQL / MariaDB) ─────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=connect_myuni
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ── Admin Session ────────────────────────────────────────
SESSION_NAME=connectmyuni_session
SESSION_LIFETIME=1440
